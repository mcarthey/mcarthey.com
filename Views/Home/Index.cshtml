@{
    ViewData["Title"] = "Console";
}

<div id="terminal-interface" class="max-w-6xl mx-auto">

    <!-- Boot Sequence -->
    <div id="boot-sequence" class="mb-8">
        <div class="terminal-text text-lg mb-4">
            <div id="boot-text"></div>
        </div>
        <div id="skip-button" class="mt-6 text-center">
            <button onclick="skipBootSequence()" class="nav-button text-xs pulse-animation">
                ⏭ SKIP BOOT
            </button>
        </div>
    </div>

    <!-- System header (after boot) -->
    <div id="welcome-header" class="hidden mb-8">
        <div class="ascii-art text-xs mb-4">
 __  __  ____    _    ____ _____ _   _ _____ __   __
|  \/  |/ ___|  / \  |  _ \_   _| | | | ____|\ \ / /
| |\/| | |     / _ \ | |_) || | | |_| |  _|   \ V /
| |  | | |___ / ___ \|  _ < | | |  _  | |___   | |
|_|  |_|\____/_/   \_\_| \_\|_| |_| |_|_____|  |_|

        S Y S T E M   C O N S O L E
        </div>
        <div class="terminal-text text-sm mb-2">
            HOSTNAME: mcarthey-vax-01 &nbsp; | &nbsp; STATE: READY &nbsp; | &nbsp; MONITORING: ACTIVE
        </div>
        <div class="terminal-text text-xs opacity-60">
            All connections are logged. Try <span class="text-amber-400">HELP</span> for available commands.
        </div>
    </div>

    <!-- Command Interface -->
    <div id="command-interface" class="hidden mb-8">
        <div class="terminal-text mb-4">
            <span class="text-amber-400">C:\></span>
            <input type="text" id="command-input" class="command-prompt" placeholder="_" autocomplete="off">
            <span class="blink">█</span>
        </div>
        <div id="command-output" class="terminal-text text-sm"></div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (!window.terminal) {
                window.terminal = new RetroTerminal();
            }
        });
    </script>
}
